def node_require(script)
  require Pod::Executable.execute_command(
    'node',
    [
      '-p',
      "require.resolve(
        '#{script}',
        {paths: [process.argv[1]]},
      )",
      __dir__
    ].join
  ).strip
end

node_require('react-native/scripts/react_native_pods.rb')

platform :ios, '18.0'

prepare_react_native_project!

# ============================================================
# Firebase / React Native
# ============================================================

use_frameworks! :linkage => :static

$RNFirebaseAsStaticFramework = true

# ============================================================
# Main Target
# ============================================================

target 'ToutApp' do

  config = use_native_modules!

  # ==========================================================
  # Firebase dependencies
  #
  # Required when Firebase Swift pods are linked statically.
  # ==========================================================

  pod 'FirebaseAuthInterop',
    :modular_headers => true

  pod 'FirebaseAppCheckInterop',
    :modular_headers => true

  pod 'GoogleUtilities',
    :modular_headers => true

  pod 'RecaptchaInterop',
    :modular_headers => true

  # ==========================================================
  # React Native
  # ==========================================================

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # ==========================================================
  # POST INSTALL
  # ==========================================================

  post_install do |installer|

    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    # ========================================================
    # General Pod settings
    # ========================================================

    installer.pods_project.targets.each do |target|

      target.build_configurations.each do |build_config|

        # iOS 18
        build_config.build_settings[
          'IPHONEOS_DEPLOYMENT_TARGET'
        ] = '18.0'

        # Xcode 26
        build_config.build_settings[
          'SWIFT_ENABLE_EXPLICIT_MODULES'
        ] = 'NO'

        # Prevent non-modular include errors
        build_config.build_settings[
          'CLANG_WARN_NON_MODULAR_INCLUDE_IN_FRAMEWORK_MODULE'
        ] = 'NO'

      end

    end

    # ========================================================
    # React Native 0.81 C++ pods
    # ========================================================

    react_native_cpp_pods = [
      'React',
      'React-Core',
      'ReactCommon',
      'React-utils',
      'React-runtimescheduler',
      'React-runtimeexecutor',
      'React-rendererdebug',
      'React-perflogger',
      'React-featureflags',
      'React-debug',
      'React-RCTFabric',
      'React-RCTFBReactNativeSpec',
      'ReactCodegen',
      'Yoga',
      'hermes-engine'
    ]

    react_native_cpp_pods.each do |pod_name|

      target = installer.pods_project.targets.find do |t|
        t.name == pod_name
      end

      next unless target

      target.build_configurations.each do |build_config|

        build_config.build_settings[
          'IPHONEOS_DEPLOYMENT_TARGET'
        ] = '18.0'

        build_config.build_settings[
          'CLANG_CXX_LANGUAGE_STANDARD'
        ] = 'c++20'

        build_config.build_settings[
          'CLANG_CXX_LIBRARY'
        ] = 'libc++'

      end

    end

    # ========================================================
    # fmt
    #
    # Keep fmt on C++17.
    # ========================================================

    fmt_target = installer.pods_project.targets.find do |target|
      target.name == 'fmt'
    end

    if fmt_target

      fmt_target.build_configurations.each do |build_config|

        build_config.build_settings[
          'IPHONEOS_DEPLOYMENT_TARGET'
        ] = '18.0'

        build_config.build_settings[
          'CLANG_CXX_LANGUAGE_STANDARD'
        ] = 'c++17'

        build_config.build_settings[
          'CLANG_CXX_LIBRARY'
        ] = 'libc++'

      end

    end

    # ========================================================
    # gRPC
    #
    # Keep gRPC on C++17.
    # ========================================================

    [
      'gRPC-Core',
      'gRPC-C++'
    ].each do |pod_name|

      target = installer.pods_project.targets.find do |t|
        t.name == pod_name
      end

      next unless target

      target.build_configurations.each do |build_config|

        build_config.build_settings[
          'IPHONEOS_DEPLOYMENT_TARGET'
        ] = '18.0'

        build_config.build_settings[
          'CLANG_CXX_LANGUAGE_STANDARD'
        ] = 'c++17'

        build_config.build_settings[
          'CLANG_CXX_LIBRARY'
        ] = 'libc++'

      end

    end

    # ========================================================
    # Firebase modular dependencies
    # ========================================================

    firebase_modular_pods = [
      'FirebaseAuthInterop',
      'FirebaseAppCheckInterop',
      'GoogleUtilities',
      'RecaptchaInterop'
    ]

    firebase_modular_pods.each do |pod_name|

      target = installer.pods_project.targets.find do |t|
        t.name == pod_name
      end

      next unless target

      target.build_configurations.each do |build_config|

        build_config.build_settings[
          'DEFINES_MODULE'
        ] = 'YES'

        build_config.build_settings[
          'CLANG_WARN_NON_MODULAR_INCLUDE_IN_FRAMEWORK_MODULE'
        ] = 'NO'

        build_config.build_settings[
          'IPHONEOS_DEPLOYMENT_TARGET'
        ] = '18.0'

      end

    end

  end

end
